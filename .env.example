# Environment Configuration Template
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./data/user_data/nutrition_wellness.db

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=True

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-secret-key-here-change-this-to-random-string

# USDA FoodData Central API (Optional - for enhanced nutrition data)
# Get your free API key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Logging
LOG_LEVEL=INFO
